# EstateFlow Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb+srv://realestate:Estate%40123@cluster0.f5b3i3j.mongodb.net/estateflow?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=estateflow_super_secure_jwt_secret_key_2026_luxury_crm
JWT_EXPIRES_IN=7d

# Organization Default Timezone & Currency
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EstateFlow Real Estate" <noreply@estateflow.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Meta (Facebook / Instagram) Lead Ads Integration Configuration
# Obtain App ID and App Secret from developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
# Optional custom OAuth scopes (Default: public_profile,pages_show_list,pages_read_engagement,pages_manage_metadata,leads_retrieval,pages_manage_ads)
# META_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_metadata,leads_retrieval,pages_manage_ads

# -------------------------------------------------------------
# 1. FACEBOOK OAUTH REDIRECT URL
# Set this in: Meta App Dashboard -> Facebook Login -> Settings -> Valid OAuth Redirect URIs
# (Where Facebook redirects the user browser after approving Facebook Login)
# -------------------------------------------------------------
META_REDIRECT_URI=http://localhost:5173/connect-meta/callback

# -------------------------------------------------------------
# 2. FACEBOOK / META WEBHOOK URL & VERIFICATION TOKEN
# Set these in: Meta App Dashboard -> Webhooks -> Page -> Edit Subscription
# (Where Meta servers deliver real-time lead events via GET/POST)
# Callback URL: META_WEBHOOK_URL
# Verify Token: META_WEBHOOK_VERIFY_TOKEN
# -------------------------------------------------------------
META_WEBHOOK_URL=https://your-domain.ngrok-free.dev/api/meta/webhook
META_WEBHOOK_VERIFY_TOKEN=estateflow_meta_webhook_verify_token_secure_2026

# Backend Public Base URL & Frontend URL
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# AES-256 Secret for encrypting Meta Access Tokens at rest (32 bytes hex or random string)
META_ENCRYPTION_KEY=estateflow_meta_token_encryption_key_32chars!
